    "def Pr(w, n, p):\n",
    "    norm = math.factorial(n) / (math.factorial(w) * math.factorial(n-w))\n",
    "    return norm * p**w * (1-p)**(n-w)\n",
    "\n",
    "obs = 'W'\n",
    "w = obs.count('W')\n",
    "n = len(obs)\n",
    "\n",
    "ps = np.linspace(0, 1, 100)\n",
    "plt.plot(ps, Pr(w, n, p=ps));"
   ]
